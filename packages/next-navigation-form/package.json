{
  "name": "@tungv/next-navigation-form",
  "version": "0.1.0",
  "description": "GET forms that navigate with the Next.js router in a transition, keeping native form semantics as the no-JavaScript fallback.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tungv/react-primitives.git",
    "directory": "packages/next-navigation-form"
  },
  "keywords": [
    "react",
    "form",
    "nextjs",
    "navigation",
    "search",
    "filters"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json && cp src/styles.css dist/styles.css",
    "prepack": "bun run build"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "next": ">=15.0.0"
  },
  "dependencies": {
    "@tungv/react-slot": "^0.1.0",
    "@tungv/react-reserve-layout": "^0.1.0"
  },
  "devDependencies": {
    "next": "16.3.5"
  }
}
