{
  "name": "@tungv/react-grid-list",
  "version": "0.1.0",
  "description": "Accessible React grid list: one tab stop, arrow-key rows and actions, selection, form fields, and a hover highlight that glides between rows. Safe for streamed, partially hydrated rows.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tungv/react-primitives.git",
    "directory": "packages/react-grid-list"
  },
  "keywords": [
    "react",
    "grid",
    "aria",
    "accessibility",
    "keyboard",
    "selection",
    "rsc"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json && cp src/styles.css dist/styles.css",
    "prepack": "bun run build"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@tungv/react-hover-highlight": "workspace:^",
    "@tungv/react-slot": "workspace:^"
  }
}
