{
  "name": "@tungv/slot",
  "version": "0.1.0",
  "description": "asChild and render-prop merging for React: one child element rendered with a part's props laid under its own (handlers chained, classes joined, styles merged, refs both set).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tungv/primitives.git",
    "directory": "packages/slot"
  },
  "keywords": [
    "react",
    "slot",
    "aschild",
    "render-prop",
    "composition"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "prepack": "bun run build"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  }
}
