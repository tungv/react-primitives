{
  "name": "@tungv/react-form",
  "version": "0.1.0",
  "description": "Accessible React form primitives on native constraint validation: fields, labels, controls, messages, auto-submit and masked input.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tungv/react-primitives.git",
    "directory": "packages/react-form"
  },
  "keywords": [
    "react",
    "form",
    "validation",
    "aria",
    "accessibility",
    "masked-input"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json && cp src/styles.css dist/styles.css",
    "prepack": "bun run build"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "dependencies": {
    "@tungv/react-slot": "^0.1.0",
    "@tungv/react-reducer-context": "^0.1.0",
    "@tungv/react-reserve-layout": "^0.1.0"
  }
}
