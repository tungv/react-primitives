{
  "name": "@tungv/react-hover-highlight",
  "version": "0.1.0",
  "description": "One hover highlight that glides between the items of a React list, positioned by CSS anchor positioning. No measuring, no re-renders on hover, safe while rows stream in.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tungv/react-primitives.git",
    "directory": "packages/react-hover-highlight"
  },
  "keywords": [
    "react",
    "hover",
    "highlight",
    "anchor-positioning",
    "css",
    "animation"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json && cp src/styles.css dist/styles.css",
    "prepack": "bun run build"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "dependencies": {
    "@tungv/react-slot": "workspace:^"
  }
}
