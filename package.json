{
  "name": "@tungv/grid-list",
  "version": "0.1.0",
  "description": "Accessible React grid list: one tab stop, arrow-key rows and actions, selection, form fields, and a hover highlight that glides between rows. Safe for streamed, partially hydrated rows.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tungv/grid-list.git"
  },
  "keywords": [
    "react",
    "grid",
    "listbox",
    "aria",
    "accessibility",
    "keyboard",
    "selection",
    "rsc"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./hover-highlight": {
      "types": "./dist/hover-highlight.d.ts",
      "default": "./dist/hover-highlight.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cp src/styles.css dist/styles.css",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run typecheck && bun run test && bun run build && bun scripts/check-dist.ts",
    "prepublishOnly": "bun run check"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.4",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.4.2"
}
